# ==============================================================================
# Verity Academic Integrity Platform - Environment Configuration Template
# Copy this file to '.env' (or '.env.local') and provide your Supabase project credentials.
# ==============================================================================

# Client-side Supabase credentials (safe for browser exposure via Vite)
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-public-anon-key...

# IMPORTANT SECURITY NOTE:
# NEVER put the service_role key into variables with the VITE_ prefix!
# Vite bundles all VITE_* variables into client-side JS bundles.
# If you run backend edge functions or background server workers:
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role-key-only-in-server-env...
